rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /usernames/{username} {
      allow read: if false;
      allow write: if false;
    }
    // Published app news (see admin.html + publishNews/updateNewsItem/
    // deleteNewsItem, functions/index.js) -- any signed-in player can read
    // the menu's Novedades panel, but writes only ever happen server-side
    // (the Cloud Functions themselves check the caller is the one admin
    // account), same "client never writes directly" pattern as users/{uid}.
    match /news/{newsId} {
      allow read: if request.auth != null;
      allow write: if false;

      // A news item's optional gift (see claimNewsGift, functions/index.js)
      // is claimed once per player -- a player can only ever read whether
      // THEY already claimed it, never anyone else's claim doc or write one
      // themselves (only the Admin SDK, inside claimNewsGift's transaction,
      // can create one).
      match /claims/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Shop prices and Telegram Stars economy config -- readable by any signed-in player
    // so the live shop reflects prices set by admin; writes are server-side only.
    match /config/economy {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admin-only game-balance config (currently just rareOdds -- the
    // "Probabilidades" tab's per-card weights, see setRareOdds/
    // fetchRareWeights, functions/index.js). Only the admin panel ever
    // needs to read this (players never see booster odds), so unlike
    // news/{id}'s "any signed-in player" read, this is scoped to the same
    // one admin uid those Cloud Functions check -- keep this literal in
    // sync with ADMIN_UID there if it's ever rotated.
    match /config/{doc} {
      allow read: if request.auth != null && request.auth.uid == '4ViFsoJm7fMsop8eCS16u89wIxQ2';
      allow write: if false;
    }

    // Admin-curated gift-only packs (see saveCustomPack/claimNewsGift,
    // functions/index.js, and admin.html's "Packs" tab) -- any signed-in
    // player can read one (the shop's "PACK GRATIS" slot/modal needs each
    // pending pack's name/art to display it), writes only ever happen
    // server-side via the admin-gated Cloud Functions.
    match /customPacks/{packId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Admin-only redeemable gift codes (see saveGiftCode/redeemGiftCode,
    // functions/index.js, and admin.html's "Códigos" tab). Redemption is
    // fully server-side (the player never needs to read a code doc to
    // redeem it, they just submit the string to redeemGiftCode), so unlike
    // customPacks this is admin-only read, same as config/{doc} above.
    match /giftCodes/{code} {
      allow read: if request.auth != null && request.auth.uid == '4ViFsoJm7fMsop8eCS16u89wIxQ2';
      allow write: if false;

      match /redemptions/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // PVP Fase 1 (see docs/superpowers/specs/2026-08-27-pvp-fase1-design.md).
    // A room is created/joined/readied only via Cloud Functions
    // (createRoom/joinRoom/setReady) -- a joining client never reads a room
    // directly before joining, so this scoped read is only ever exercised
    // by the two players actually in it (their own listener, once joined).
    match /rooms/{roomCode} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.hostUid || request.auth.uid == resource.data.guestUid);
      allow write: if false;
    }

    // matches/{matchId}: the public, redacted board both players read
    // directly in real time. Scoped to just the two participants -- board
    // state (even redacted) is not any other signed-in player's business.
    match /matches/{matchId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.players.player1 || request.auth.uid == resource.data.players.player2);
      allow write: if false;

      // Each player's own real hand -- never readable by the other side.
      match /private/{uid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // The complete un-redacted engine state (both hands, deck order,
      // un-taken prize identities) -- no client, ever, ours or theirs.
      // Only submitMatchAction/setReady (Admin SDK) ever touch this.
      match /serverOnly/{doc} {
        allow read: if false;
        allow write: if false;
      }
    }
  }
}
